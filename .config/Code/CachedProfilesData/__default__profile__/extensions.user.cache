tle":"Blackbox Explain Code"},{"command":"extension.explainCodeStatusBar","title":"Blackbox Explain File Code"},{"command":"extension.improveCode","title":"Blackbox Improve Code"},{"command":"blackbox.historySearch","title":"Blackbox Saved Snippets","category":"blackbox"},{"command":"blackbox.showChat","title":"Blackbox AI Chat"},{"command":"blackbox.showDiff","title":"Blackbox Diff view"},{"command":"blackbox.cleanDiff","title":"Blackbox Clean Diff History"},{"command":"blackbox.readMe","title":"Create README.md"},{"command":"blackbox.commitMsg","title":"AI Commit Message"},{"command":"blackbox.commentFile","title":"Blackbox Comment File"},{"command":"blackbox.bugReport","title":"Blackbox Bug Report"},{"command":"extension.blackbox-connect","title":"Blackbox Connect"},{"command":"blackbox.generateRepo","title":"Blackbox Generate Repo"},{"command":"blackbox.editorChat","title":"Blackbox Review Code"},{"command":"blackbox.welcome","title":"Help & Getting Started","category":"Blackbox","group":"Blackbox","icon":"$(bold)"},{"command":"blackbox.comment.add","title":"Ask Blackbox","category":"Blackbox"},{"command":"blackbox.openBrowser","title":"Open Blackbox Browser","category":"Blackbox","group":"Blackbox","icon":"$(bold)"},{"command":"blackbox.terminal.search","title":"Terminal Search","category":"Blackbox","group":"Blackbox","icon":"$(bold)"},{"command":"extension.saveCodeToCloud","title":"Blackbox Share Code Link","category":"Blackbox","group":"Blackbox","icon":"$(bold)"},{"command":"blackbox.triggerOnCtrlI","title":"Trigger on Ctrl+U / Cmd+U"},{"command":"extension.inlineQuality","title":"Blackbox Inline Quality Mode"},{"command":"extension.inlineSpeed","title":"Blackbox Inline Beast Mode"},{"command":"extension.autocompleteQuality","title":"Blackbox Autocomplete Quality Mode"},{"command":"extension.autocompleteSpeed","title":"Blackbox Autocomplete Beast Mode"}],"keybindings":[{"command":"extension.activateContext","key":"ctrl+i","mac":"cmd+i"},{"command":"extension.saveText","key":"ctrl+alt+l","mac":"shift+cmd+i"},{"command":"extension.acceptSuggestion","key":"tab","mac":"tab","when":"inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorTabMovesFocus"},{"command":"blackbox.triggerOnCtrlI","key":"ctrl+l","mac":"cmd+L","when":"editorTextFocus"}],"menus":{"editor/context":[{"command":"extension.saveText","group":"Blackbox"},{"command":"extension.getSuggest","group":"Blackbox"},{"command":"extension.saveCodeToCloud","group":"Blackbox"},{"command":"extension.explainCode","group":"Blackbox"},{"command":"extension.improveCode","group":"Blackbox"},{"command":"extension.openChat","group":"Blackbox"}],"scm/title":[{"command":"blackbox.commitMsg","when":"scmProvider == git","group":"navigation","title":"Commit Prefill"}],"commandPalette":[{"command":"blackbox.comment.add","when":"false"},{"command":"blackbox.terminal.search","when":"blackbox.newInstallation"}],"comments/commentThread/context":[{"command":"blackbox.comment.add","group":"inline"}]},"walkthroughs":[{"id":"blackbox.welcomeStep","title":"Getting Started with BLACKBOX AI","description":"Write and Review Code with the help of our AI-powered Code Autocomplete, Code Chat & Much More Features to Increase Developers' Productivity","steps":[{"id":"openCodeChat","title":"BLACKBOX Code Chat","description":"This is a walkthrough for using BLACKBOX AI Code Chat.\nTo get answers to your coding questions:\n\n1. Open the BLACKBOX Code Chat.\n2. Ask your coding question.\n3. Get answers and suggestions in real-time.","media":{"markdown":"walkthroughs/BLACKBOXCodeChat.md"}},{"id":"openCodeAutocomplete","title":"BLACKBOX Code Autocomplete","description":"This is a walkthrough for using BLACKBOX AI Code Autocomplete.\nTo get code suggestions as you type:\n\n1. Write a line of code.\n2. Press Enter and you will see the suggestion.\n3. Press Tab to accept the suggestion","media":{"markdown":"walkthroughs/BLACKBOXCodeAutocomplete.md"}},{"id":"generateAICode","title":"BLACKBOX AI Generate Code","description":"This is a walkthrough for generating code with BLACKBOX AI.\nTo generate code using AI:\n\n1. Open a file with code.\n2. Right click and press Blackbox Generate Code\n3. Blackbox will start writing the lines of code","media":{"markdown":"walkthroughs/BLACKBOXAIGenerateCode.md"}},{"id":"commitAI","title":"BLACKBOX AI Commit","description":"This is a walkthrough for using AI to commit code in BLACKBOX.\nTo commit your code using AI:\n\n1. Click on the Sidebar Source Control.\n2. Press the B icon.\n3. Blackbox will generate the commit message.","media":{"markdown":"walkthroughs/BLACKBOXAICOMMIT.md"}},{"id":"openViewDiff","title":"BLACKBOX View Diff","description":"This is a walkthrough for viewing diffs in BLACKBOX.\nTo see the differences in your code:\n\n1. Open the file you want to compare.\n2. Click on the \"View Diff\" button in the top-right corner.","media":{"markdown":"walkthroughs/BLACKBOXViewDiff.md"}},{"id":"scheduleOnboarding","title":"BLACKBOX AI Schedule Onboarding","description":"This is a walkthrough for scheduling your BLACKBOX AI onboarding.\nTo schedule your onboarding:\n\n1. Open your BLACKBOX settings.\n2. Navigate to the Onboarding section.\n3. Select the time that suits you for the AI-guided onboarding session.","media":{"markdown":"walkthroughs/BLACKBOXAIScheduleOnboarding.md"}}]}]},"scripts":{"lint":"eslint . --ext .ts,.tsx","watch":"tsc -watch -p ./","download-api":"vscode-dts dev","postdownload-api":"vscode-dts main","postinstall":"npx vscode-dts dev","test-compile":"tsc -p ./","build":"vsce package -o ./out-vsix","test":"jest"},"devDependencies":{"@types/diff":"^5.2.1","@types/jest":"^27.4.1","@types/node":"^14.15.0","@types/node-fetch":"^2.5.10","@typescript-eslint/eslint-plugin":"^4.16.0","@typescript-eslint/parser":"^4.16.0","bufferutil":"^4.0.3","esbuild":"^0.12.15","eslint":"^7.21.0","jest":"^27.5","node-loader":"^2.0.0","ts-jest":"^27.1.4","ts-loader":"^9.2.3","typescript":"^4.2.2","utf-8-va