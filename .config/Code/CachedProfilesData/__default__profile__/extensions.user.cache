4-7255","activationEvents":["onStartupFinished","workspaceContains:.devcontainer/devcontainer.json","workspaceContains:.devcontainer.json","onResolveRemoteAuthority:dev-container","onResolveRemoteAuthority:attached-container","onResolveRemoteAuthority:k8s-container","onDebugResolve:extensionHost"],"main":"./dist/extension/extension","l10n":"./l10n","enabledApiProposals":["resolvers","tunnels","workspaceTrust","terminalDimensions","contribEditSessions","contribViewsRemote","contribRemoteHelp"],"contributes":{"continueEditSession":[{"command":"remote-containers.openRepositoryFromRemoteHubWithEditSession","group":"0_local@2","when":"!isWeb && remoteHub:hasVirtualFolders","qualifiedName":"Seguir trabajando en el volumen del contenedor","remoteGroup":"remote_30_dev-container_2_actions@8"},{"command":"remote-containers.openRepositoryFromGitWithEditSession","group":"0_local@2","when":"git.state == initialized && gitOpenRepositoryCount != 0 && remoteName =~ /(codespaces*.*|tunnel)/ && false","qualifiedName":"Seguir trabajando en el volumen del contenedor","remoteGroup":"remote_30_dev-container_2_actions@8"}],"languages":[{"id":"jsonc","filenames":["devcontainer-feature.json",".devcontainer-internal.json"]}],"jsonValidation":[{"fileMatch":"devcontainer-feature.json","url":"https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"}],"configuration":{"title":"Contenedores de desarrollo","properties":{"remote.containers.defaultExtensions":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.defaultExtensions\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dev.containers.defaultExtensions#\" en su lugar."},"dev.containers.defaultExtensions":{"scope":"application","type":"array","description":"Configura la lista de extensiones a instalar siempre al crear un contenedor.","default":[],"items":{"type":"string","pattern":"([a-z0-9A-Z][a-z0-9\\-A-Z]*)\\.([a-z0-9A-Z][a-z0-9\\-A-Z]*)","errorMessage":"Se esperaba el formato '${publisher}.${name}'. Ejemplo: 'vscode.csharp'."}},"dev.containers.defaultExtensionsIfInstalledLocally":{"scope":"application","type":"array","description":"Configure la lista de extensiones que se van a instalar al crear un contenedor si ya están instaladas localmente.","default":["GitHub.copilot","GitHub.copilot-chat","GitHub.vscode-pull-request-github"],"items":{"type":"string","pattern":"([a-z0-9A-Z][a-z0-9\\-A-Z]*)\\.([a-z0-9A-Z][a-z0-9\\-A-Z]*)","errorMessage":"Se esperaba el formato '${publisher}.${name}'. Ejemplo: 'vscode.csharp'."}},"dev.containers.defaultFeatures":{"scope":"application","type":"object","description":"Configura la lista de características a instalar siempre al crear un contenedor.","default":{}},"remote.containers.workspaceMountConsistency":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.workspaceMountConsistency\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dev.containers.workspaceMountConsistency#\" en su lugar."},"dev.containers.workspaceMountConsistency":{"scope":"application","type":"string","enum":["consistent","cached","delegated"],"enumDescriptions":["Consistencia perfecta.","La vista del host es autoritativa.","La vista del contenedor es autoritativa."],"description":"El nivel de consistencia utilizado para el montaje del área de trabajo (los contenedores existentes deben reconstruirse para que surta efecto).","default":"cached"},"dev.containers.gpuAvailability":{"scope":"machine","type":"string","enum":["all","detect","none"],"enumDescriptions":["Todas las GPU están disponibles. Esto espera que el host tenga una GPU.","La disponibilidad debe detectarse automáticamente.","No hay GPU disponibles."],"description":"Disponibilidad de GPU cuando un contenedor de desarrollo requiere alguna.","default":"detect"},"remote.containers.cacheVolume":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.cacheVolume\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.cacheVolume#` instead."},"dev.containers.cacheVolume":{"scope":"application","type":"boolean","description":"Controla si debe utilizarse un volumen Docker para almacenar en caché el servidor y las extensiones de VS Code. Actualmente solo se aplica a configuraciones de contenedor único y no de Docker Compose.","default":true},"remote.containers.copyGitConfig":{"scope":"machine","deprecationMessage":"Utilice \"dev.containers.copyGitConfig'\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dev.containers.copyGitConfig#\" en su lugar."},"dev.containers.copyGitConfig":{"scope":"machine","type":"boolean","markdownDescription":"Controla si la configuración de Git (`~/.gitconfig`) debe copiarse en el contenedor. Esto se hace después de instalar cualquier \"#dotfiles.repository#\" y no sobrescribirá un archivo de configuración Git existente.","default":true},"remote.containers.gitCredentialHelperConfigLocation":{"scope":"machine","deprecationMessage":"Utilice \"dev.containers.gitCredentialHelperConfigLocation\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.gitCredentialHelperConfigLocation#` instead."},"dev.containers.gitCredentialHelperConfigLocation":{"scope":"machine","type":"string","enum":["system","global","none"],"enumDescriptions":["Escribir en la configuración del sistema (\"/etc/gitconfig\", requiere acceso a la raíz).","Escribir en la configuración de usuario (`~/.gitconfig`).","No establezca un ayudante de credenciales."],"description":"Dónde escribir la configuración para el ayudante de credenciales Git.","default":"global"},"dev.containers.dockerCredentialHelper":{"scope":"machine","type":"boolean","markdownDescription":"Controla si un ayudante de credenciales debe registrarse como \"credStore\" en la configuración de Docker (\"~/.docker/config.json\") de los contenedores dev. Esto no sobrescribirá una entrada \"credStore\" existente en el archivo de configuración.","default":true},"dev.containers.mountWaylandSocket":{"scope":"application","ignoreSync":true,"type":"boolean","markdownDescription":"Controla si un socket Wayland, si existe, debe ser montado en el contenedor de desarrollo.","default":true},"remote.containers.logLevel":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.logLevel\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.logLevel#` instead."},"dev.containers.logLevel":{"scope":"application","type":"string","description":"Nivel de registro de la extensión.","default":"debug","enum":["info","debug","trace"]},"remote.containers.dockerPath":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.dockerPath\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dev.containers.dockerPath#\" en su lugar."},"dev.containers.dockerPath":{"scope":"application","type":"string","description":"Nombre o ruta del ejecutable de Docker (o Podman).","default":"docker"},"remote.containers.dockerComposePath":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.dockerComposePath\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.dockerComposePath#` instead."},"dev.containers.dockerComposePath":{"scope":"application","type":"string","description":"Nombre o ruta del ejecutable de Docker Compose.","default":"docker-compose"},"dev.containers.dockerSocketPath":{"scope":"application","type":"string","description":"Ruta de acceso del socket de Docker. Se usa, por ejemplo, al conectarse a un contenedor de desarrollo con devcontainer.json en un volumen de Docker.","default":"/var/run/docker.sock"},"remote.containers.executeInWSL":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.executeInWSL\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.executeInWSL#` instead."},"dev.containers.executeInWSL":{"scope":"application","type":"boolean","description":"Controla si los comandos CLI deben ejecutarse siempre en WSL. Por defecto, solo se ejecutan en WSL para las carpetas del área de trabajo en WSL. Esta configuración no tiene efecto en otras plataformas que no sean Windows.","default":false},"remote.containers.executeInWSLDistro":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.executeInWSLDistro\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.executeInWSLDistro#` instead."},"dev.containers.executeInWSLDistro":{"scope":"application","type":"string","markdownDescription":"Distribución WSL a utilizar cuando no se reabre una carpeta WSL. Por defecto se utiliza la distribución WSL por defecto (ver \"wsl -l\"). Este ajuste no tiene efecto cuando \"#dev.containers.executeInWSL#\" no está habilitado o en otras plataformas que no sean Windows."},"dev.containers.forwardWSLServices":{"scope":"application","type":"boolean","description":"Controla si los servicios de WSL (agente SSH, agente GPG, pantalla X, pantalla Wayland) se reenvían al contenedor. Esta configuración no tiene ningún efecto en otras plataformas que no sean Windows.","default":true},"dotfiles.repository":{"scope":"machine","type":"string","description":"URL de un repositorio Git dotfiles (por ejemplo, https://github.com/owner/repository.git) o propietario/repositorio de un repositorio GitHub."},"dotfiles.installCommand":{"scope":"machine","type":"string","description":"El comando a ejecutar después de clonar el repositorio dotfiles. Por defecto ejecuta el primer archivo de \"install.sh\", \"install\", \"bootstrap.s\", \"bootstrap\", \"setup.sh\" y \"setup\" que se encuentre en la carpeta raíz del repositorio dotfiles."},"dotfiles.targetPath":{"scope":"machine","type":"string","description":"La ruta para clonar el repositorio dotfiles. Por defecto es \"~/dotfiles\".","default":"~/dotfiles"},"remote.containers.dotfiles.repository":{"scope":"machine","deprecationMessage":"Utilice \"dotfiles.repository\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dotfiles.repository#\" en su lugar."},"remote.containers.dotfiles.installCommand":{"scope":"machine","deprecationMessage":"Utilice \"dotfiles.installCommand\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dotfiles.installCommand#\" en su lugar."},"remote.containers.dotfiles.targetPath":{"scope":"machine","deprecationMessage":"Utilice \"dotfiles.targetPath\" en su lugar.","markdownDeprecationMessage":"Utilice \"#dotfiles.targetPath#\" en su lugar."},"remote.containers.repositoryConfigurationPaths":{"scope":"application","deprecationMessage":"Utilice \"dev.containers.repositoryConfigurationPaths\" en su lugar.","markdownDeprecationMessage":"Use `#dev.containers.repositoryConfigurationPaths#` instead."},"dev.containers.repositoryConfigurationPaths":{"scope":"application","type":"array","markdownDescription":"Lista de rutas de acceso adicionales para buscar [configuraciones de repositorio](https://code.visualstudio.com/docs/devcontainers/create-dev-container#_alternative-repository-configuration-folders).","default":[],"items":{"type":"string"}},"dev.containers.experimentalLockfile":{"scope":"application","type":"boolean","description":"Controla si se debe escribir un devcontainer-lock.json experimental. Esta funcionalidad es experimental y puede cambiar en el futuro.","default":false},"dev.containers.optimisticallyLaunchDocker":{"scope":"application","type":"boolean","description":"De forma optimista, intenta iniciar Docker si el demonio aún no se está ejecutando.","default":true}}},"commands":[{"command":"remote-containers.reopenInContainer","title":{"value":"Volver a abrir en el contenedor","original":"Reopen in Container"},"category":{"value":"Contenedores de desarrollo","original":"Dev Containers"}},{"command":"remote-containers.rebuildAndReopenInContainer","title":{"value":"Recompilar y reabrir en contenedor","original":"Rebuild and Reopen in Container"},"category":{"value":"Contenedores de desarrollo","original":"Dev Containers"}},{"command":"remote-containers.rebuildNoCacheAndReopenInContainer","title":{"value":"Volver a generar sin caché y abrir de nuevo en contenedor",